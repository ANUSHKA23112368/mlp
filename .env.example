# ─────────────────────────────────────────────────────────────────
# CivicShield AI — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────
APP_ENV=development          # development | staging | production
APP_SECRET_KEY=change-me-to-a-long-random-string-min-32-chars

# ── JWT Authentication ────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-another-long-random-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── Database ──────────────────────────────────────────────────────
# SQLite (development default)
DATABASE_URL=sqlite:///./civicshield.db
# PostgreSQL (staging / production)
# DATABASE_URL=postgresql://user:password@localhost:5432/civicshield

# ── Redis / Task Queue ────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── CORS ──────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8501

# ── Rate Limiting ─────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60

# ── ML & Model Paths ─────────────────────────────────────────────
MODEL_DIR=models
MLFLOW_TRACKING_URI=mlruns

# ── Security Module ───────────────────────────────────────────────
SECURITY_DEMO_MODE=true      # true = label all generated events as demo
ANOMALY_CONTAMINATION=0.05   # expected fraction of anomalies

# ── Streaming ─────────────────────────────────────────────────────
SSE_KEEPALIVE_SECONDS=15

# ── Logging ───────────────────────────────────────────────────────
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json              # json | text
